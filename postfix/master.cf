# ==================================================================
# Postfix — master.cf (службы)
# Восстановлен и модернизирован 2026-10. Синтаксис:
#   service  type  private unpriv chroot wakeup maxproc command
# Строки продолжения опций начинаются с пробела — не убирайте!
# ==================================================================

# ---------------- Приём из интернета :25 ---------------------------
# Входящая почта сразу уходит в Amavis (10024), обратно — на 127.0.0.1:10025.
# chroot=y — стандарт Ubuntu; работает, т.к. milters и проверки — по
# TCP, а сокеты policyd-spf/dovecot-lmtp/private/auth лежат внутри chroot.
smtp      inet  n       -       y       -       -       smtpd
  -o content_filter=smtp-amavis:[127.0.0.1]:10024

# ---------------- Отправка клиентами (MUA) -------------------------
# 587 submission — STARTTLS обязателен (RFC 6409)
submission inet n       -       y       -       -       smtpd
  -o syslog_name=postfix/submission
  -o smtpd_tls_security_level=encrypt
  -o smtpd_sasl_auth_enable=yes
  -o smtpd_client_restrictions=permit_sasl_authenticated,reject
  -o smtpd_relay_restrictions=permit_sasl_authenticated,reject
  -o smtpd_recipient_restrictions=permit_sasl_authenticated,reject
  -o milter_macro_daemon_name=ORIGINATING

# 465 submissions — неявный TLS. Современный рекомендуемый порт (RFC 8314).
# В старой конфигурации блок был закомментирован/отсутствовал.
smtps     inet  n       -       y       -       -       smtpd
  -o syslog_name=postfix/smtps
  -o smtpd_tls_wrappermode=yes
  -o smtpd_sasl_auth_enable=yes
  -o smtpd_client_restrictions=permit_sasl_authenticated,reject
  -o smtpd_relay_restrictions=permit_sasl_authenticated,reject
  -o smtpd_recipient_restrictions=permit_sasl_authenticated,reject
  -o milter_macro_daemon_name=ORIGINATING

# ---------------- Amavis: передача на проверку ---------------------
smtp-amavis unix -      -       y       -       2       smtp
  -o smtp_data_done_timeout=1200
  -o smtp_send_xforward_command=yes
  -o disable_dns_lookups=yes
  -o max_use=20

# ---------------- Amavis: возврат проверенной почты -----------------
# Все проверки здесь ВЫКЛЮЧЕНЫ (письмо уже проверено на входе),
# включая milters (no_milters) — иначе OpenDKIM/OpenDMARC обработали
# бы одно и то же письмо дважды и задублировали Authentication-Results.
# Подпись исходящей почты происходит ещё ДО Amavis — на submission/smtps,
# поэтому no_milters на 10025 безопасен.
127.0.0.1:10025 inet n  -       y       -       -       smtpd
  -o content_filter=
  -o smtpd_delay_reject=no
  -o smtpd_client_restrictions=permit_mynetworks,reject
  -o smtpd_helo_restrictions=
  -o smtpd_sender_restrictions=
  -o smtpd_recipient_restrictions=permit_mynetworks,reject
  -o smtpd_data_restrictions=reject_unauth_pipelining
  -o smtpd_end_of_data_restrictions=
  -o smtpd_restriction_classes=
  -o mynetworks=127.0.0.0/8
  -o smtpd_error_sleep_time=0
  -o smtpd_soft_error_limit=1001
  -o smtpd_hard_error_limit=1000
  -o smtpd_client_connection_count_limit=0
  -o smtpd_client_connection_rate_limit=0
  -o receive_override_options=no_header_body_checks,no_unknown_recipient_checks,no_milters,no_address_mappings

# ---------------- SPF: postfix-policyd-spf-python -------------------
# (вызов из main.cf: check_policy_service unix:private/policyd-spf)
policyd-spf  unix  -       n       n       -       0       spawn
    user=policyd-spf argv=/usr/bin/policyd-spf

# ---------------- Стандартные службы (как в поставке Ubuntu) --------
pickup    unix  n       -       y       60      1       pickup
cleanup   unix  n       -       y       -       0       cleanup
qmgr      unix  n       -       n       300     1       qmgr
tlsmgr    unix  -       -       y       1000?   1       tlsmgr
rewrite   unix  -       -       y       -       -       trivial-rewrite
bounce    unix  -       -       y       -       0       bounce
defer     unix  -       -       y       -       0       bounce
trace     unix  -       -       y       -       0       bounce
verify    unix  -       -       y       -       1       verify
flush     unix  n       -       y       1000?   0       flush
proxymap  unix  -       -       n       -       -       proxymap
proxywrite unix -       -       n       -       1       proxymap
smtp      unix  -       -       y       -       -       smtp
relay     unix  -       -       y       -       -       smtp
  -o syslog_name=postfix/$service_name
showq     unix  n       -       y       -       -       showq
error     unix  -       -       y       -       -       error
retry     unix  -       -       y       -       -       error
discard   unix  -       -       y       -       -       discard
local     unix  -       n       n       -       -       local
virtual   unix  -       n       n       -       -       virtual
lmtp      unix  -       -       y       -       -       lmtp
anvil     unix  -       -       y       -       1       anvil
scache    unix  -       -       y       -       1       scache
postlog   unix-dgram n  -       n       -       1       postlogd
maildrop  unix  -       n       n       -       -       pipe
  flags=DRXhu user=vmail argv=/usr/bin/maildrop -d ${recipient}
uucp      unix  -       n       n       -       -       pipe
  flags=Fqhu user=uucp argv=uux -r -n -z -a$sender - $nexthop!rmail ($recipient)
