# ==================================================================
# Postfix — main.cf (MTA: приём/отправка почты)
#
# ВОССТАНОВЛЕН И МОДЕРНИЗИРОВАН 2026-10 (в репозитории файл отсутствовал —
# существовало только имя в метаданных etckeeper).
# Целевые версии: Postfix 3.8 (Ubuntu 24.04 LTS); совместимо с 3.4+.
# Документация: http://www.postfix.org/postconf.5.html
# Проверка:  postconf -n && postfix check && systemctl reload postfix
# ==================================================================

compatibility_level = 3.6

# -------------------- Идентификация сервера ------------------------
# FQDN почтового сервера. Обязателен к сведению воедино:
#   PTR (reverse DNS) публичного IP == myhostname == HELO == имя в сертификате
myhostname = mail.mymyblog.cf
mydomain = mymyblog.cf
myorigin = $mydomain

# Локальные домены — ТОЛЬКО системные. Почтовый домен mymyblog.cf обслуживается
# виртуально (virtual_mailbox_domains ниже) и НЕ должен здесь повторяться,
# иначе почта на реальные ящики будет падать с "User unknown in local recipient table".
mydestination = $myhostname, localhost.$mydomain, localhost

inet_interfaces = all
# ВАЖНО: оставляйте IPv6 (all) только если у v6-адреса есть корректная PTR-запись
# и настроен SPF с ip6 — иначе Gmail/Mail.ru будут отклонять письма.
# При сомнениях: inet_protocols = ipv4
inet_protocols = all

mynetworks = 127.0.0.0/8 [::ffff:127.0.0.0]/104 [::1]/128

alias_maps = hash:/etc/aliases
alias_database = hash:/etc/aliases
recipient_delimiter = +

# -------------------- Виртуальные домены и ящики -------------------
# Как и в исходном сервере — hash-карты (postmap после каждого изменения!).
virtual_mailbox_domains = hash:/etc/postfix/vhost        # список доменов (домен -> любой текст)
virtual_mailbox_base    = /var/mail/vhosts
virtual_mailbox_maps    = hash:/etc/postfix/vmailbox     # user@domain -> domain/user/ (только существующие ящики)
virtual_alias_maps      = hash:/etc/postfix/virtual      # алиасы/пересылки
virtual_minimum_uid     = 100
virtual_uid_maps        = static:5000                     # пользователь vmail
virtual_gid_maps        = static:5000
# Доставка во «виртуальные» ящики — через Dovecot LMTP (см. 10-master.conf Dovecot)
virtual_transport = lmtp:unix:private/dovecot-lmtp

# -------------------- TLS: сервер (приём) --------------------------
# УСТАРЕВШЕЕ (встречается в руководствах 6-летней давности — НЕ использовать):
#   smtpd_use_tls = yes                    -> заменено на smtpd_tls_security_level (DEPRECATION_README)
#   smtpd_tls_session_cache_database = btree:/var/lib/postfix/smtpd_scache вручную — не нужно,
#                                          кэш ведёт tlsmgr; достаточно значения ниже
#   smtpd_tls_dh1024_param_file            -> не нужен: в Postfix >= 3.1 встроены
#                                          безопасные FFDHE-параметры (файл postfix/dhparams.pem
#                                          из старого сервера можно удалить)
smtpd_tls_security_level = may
smtpd_tls_cert_file = /etc/letsencrypt/live/mail.mymyblog.cf/fullchain.pem
smtpd_tls_key_file  = /etc/letsencrypt/live/mail.mymyblog.cf/privkey.pem
# Синтаксис ">=" поддерживается с Postfix 3.6 — TLS 1.0/1.1 отключены (RFC 8996)
smtpd_tls_protocols          = >=TLSv1.2
smtpd_tls_mandatory_protocols = >=TLSv1.2
smtpd_tls_mandatory_ciphers  = high
tls_preempt_cipherlist       = yes
smtpd_tls_received_header    = yes
smtpd_tls_session_cache_database = btree:${data_directory}/smtpd_scache
# AUTH только внутри TLS-сеанса (на 25/tcp, где TLS опционален)
smtpd_tls_auth_only = yes

# -------------------- TLS: клиент (отправка наружу) ----------------
# УСТАРЕВШЕЕ: smtp_use_tls = yes (замена — smtp_tls_security_level),
# tls_random_source = dev:/dev/urandom (не нужен с OpenSSL >= 1.1.1, может дать предупреждение)
smtp_tls_security_level = may
smtp_tls_loglevel = 1
smtp_tls_protocols = >=TLSv1.2
smtp_tls_CAfile = /etc/ssl/certs/ca-certificates.crt
smtp_tls_session_cache_database = btree:${data_directory}/smtp_scache

# -------------------- SASL-аутентификация (через Dovecot) -----------
smtpd_sasl_type = dovecot
smtpd_sasl_path = private/auth
smtpd_sasl_auth_enable = yes
smtpd_sasl_security_options = noanonymous, noplaintext
smtpd_sasl_tls_security_options = noanonymous
smtpd_sasl_local_domain = $myhostname
broken_sasl_auth_clients = yes
# Логин SASL == адрес отправителя (подмена From запрещена).
smtpd_sender_login_maps = hash:/etc/postfix/vmailbox

# -------------------- SMTP-ограничения (антиспам на уровне сессии) --
smtpd_helo_required = yes
disable_vrfy_command = yes
smtpd_discard_ehlo_keywords = etrn, silent-discard

smtpd_helo_restrictions =
  permit_mynetworks,
  permit_sasl_authenticated,
  reject_invalid_helo_hostname,
  reject_non_fqdn_helo_hostname

smtpd_sender_restrictions =
  permit_mynetworks,
  permit_sasl_authenticated,
  reject_non_fqdn_sender,
  reject_unknown_sender_domain,
  reject_authenticated_sender_login_mismatch

smtpd_relay_restrictions =
  permit_mynetworks,
  permit_sasl_authenticated,
  defer_unauth_destination

smtpd_recipient_restrictions =
  permit_mynetworks,
  permit_sasl_authenticated,
  reject_non_fqdn_recipient,
  reject_unknown_recipient_domain,
  reject_unauth_destination,
  reject_unlisted_recipient,
  # SPF-проверка входящих (пакет postfix-policyd-spf-python; см. master.cf)
  check_policy_service unix:private/policyd-spf
  # RBL подключать только со своим рекурсивным резолвером (Spamhaus
  # не отвечает публичным резолверам 8.8.8.8 и т.п.!):
  # reject_rbl_client zen.spamhaus.org=127.0.0.[2..11]

smtpd_data_restrictions = reject_unauth_pipelining

unknown_local_recipient_reject_code = 550

# -------------------- Фильтрация контента (Amavis) ------------------
# content_filter здесь НАМЕРЕННО не задаётся: фильтр включается точечно
# в master.cf на службе "smtp inet" (порт 25), чтобы не зациклить
# reinject-поток с 127.0.0.1:10025.

# -------------------- Milter: OpenDKIM + OpenDMARC ------------------
# Порядок важен: сначала DKIM (обеспечивает Authentication-Results
# для DMARC), затем DMARC. TCP-порты соответствуют opendkim.conf /
# opendmarc.conf в этом репозитории.
milter_default_action = accept
milter_protocol = 6
smtpd_milters = inet:localhost:8891, inet:localhost:8893
# Подпись почты, отправленной локально (sendmail(1)) — тоже обязательна:
non_smtpd_milters = $smtpd_milters
internal_mail_filter_classes = bounce

# -------------------- Лимиты и разное -------------------------------
message_size_limit = 52428800        # 50 МБ (больше — бессмысленно: приёмники режут)
mailbox_size_limit = 0
smtpd_banner = $myhostname ESMTP
biff = no
append_dot_mydomain = no
readme_directory = no
# Логи: Ubuntu использует syslog (rsyslog). В контейнерах без syslog
# воспользуйтесь: maillog_file = /var/log/postfix.log (Postfix >= 3.4)
